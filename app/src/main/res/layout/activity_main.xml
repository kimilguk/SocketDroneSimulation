<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#222222"
    android:padding="12dp">

    <!-- 왼쪽 조이스틱 (수직/Vertical: Throttle, Yaw) -->
    <com.example.socketdronesimulation.JoystickView
        android:id="@+id/joystickLeft"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- 오른쪽 조이스틱 (수평/Horizontal: Roll, Pitch) -->
    <com.example.socketdronesimulation.JoystickView
        android:id="@+id/joystickRight"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- 우측 제어 버튼 영역 (3개 버튼: C, M, B) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="8dp">

        <!-- V: 출발지점으로 재시작 -->
        <Button
            android:id="@+id/btnV"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_v_reset"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3" />

        <!-- C: 1인칭시점 카메라 -->
        <Button
            android:id="@+id/btnC"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_c_fpv"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50" />

        <!-- M: 하부카메라 -->
        <Button
            android:id="@+id/btnM"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_m_bottom"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800" />

        <!-- B: 폭탄투하 -->
        <Button
            android:id="@+id/btnB"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/btn_b_bomb"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D0021B" />

    </LinearLayout>

</LinearLayout>