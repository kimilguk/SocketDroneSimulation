<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#222222"
    android:padding="16dp">

    <!-- 왼쪽 조이스틱 (수직/Vertical: Throttle, Yaw) -->
    <com.example.socketdronesimulation.JoystickView
        android:id="@+id/joystickLeft"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- 중앙 제어 버튼 영역 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="16dp">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_reset_position"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A90E2"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDropBomb"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_drop_bomb"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D0021B" />

    </LinearLayout>

    <!-- 오른쪽 조이스틱 (수평/Horizontal: Roll, Pitch) -->
    <com.example.socketdronesimulation.JoystickView
        android:id="@+id/joystickRight"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>